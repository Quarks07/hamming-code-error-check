$scope module tb_hamming74 $end
$var reg       4 !    data_in [3:0] $end
$var reg       7 "    error_mask [6:0] $end
$var wire      7 #    encoded [6:0] $end
$var wire      7 $    received [6:0] $end
$var wire      7 %    corrected [6:0] $end
$var wire      3 &    syndrome [2:0] $end
